# Variáveis OPCIONAIS do aplicativo (desenvolvimento local).
# O build oficial usa a URL definida em app.json → expo.extra.notificationsApiUrl.
# Copie para ".env" apenas se quiser sobrescrever algo localmente. Nenhum valor aqui é secreto.

# URL pública (HTTPS) da API de notificações
EXPO_PUBLIC_NOTIFICATIONS_API_URL=https://sua-api.onrender.com

# Conectar aos emuladores locais do Firebase (true/false) e host deles
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
