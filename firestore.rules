rules_version = '2';

// Regras do Cloud Firestore — FIAP Chat
// Perfis, grupos, integrantes, limite, política de notificações e tokens de dispositivos.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // URL final da imagem hospedada no Cloudinary (enviada pela API) ou vazio.
    // Impede Base64, caminhos locais (file://) e URLs arbitrárias.
    function isValidPhotoUrl(url) {
      return url is string
        && (url == '' || (url.size() <= 2048 && url.matches('^https://res[.]cloudinary[.]com/.*')));
    }

    function isValidTimestamp(value) {
      return value is int && value > 0;
    }

    // ------------------------------------------------------ perfis de usuário
    // users/{uid}: parte PÚBLICA do perfil (nome e foto) — usada na busca de usuários.
    function isValidPublicProfile(uid) {
      let d = incoming();
      return d.keys().hasOnly(['uid', 'name', 'photoUrl', 'createdAt'])
        && d.keys().hasAll(['uid', 'name', 'photoUrl', 'createdAt'])
        && d.uid == uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && isValidPhotoUrl(d.photoUrl)
        && isValidTimestamp(d.createdAt);
    }

    function isValidPrivateProfile() {
      let d = incoming();
      return d.keys().hasOnly(['email', 'phoneNumber', 'birthDate'])
        && d.keys().hasAll(['email', 'phoneNumber', 'birthDate'])
        && d.email is string && d.email.size() <= 254
        && d.phoneNumber is string && d.phoneNumber.size() <= 20
        && d.birthDate is string && d.birthDate.size() <= 10;
    }

    function isValidDevice() {
      let d = incoming();
      return d.keys().hasOnly(['token', 'platform', 'enabled', 'updatedAt', 'deactivatedAt'])
        && d.token is string && d.token.size() > 0 && d.token.size() <= 512
        && d.platform in ['ios', 'android', 'web']
        && d.enabled is bool
        && isValidTimestamp(d.updatedAt);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && isValidPublicProfile(uid);
      allow update: if isSelf(uid) && isValidPublicProfile(uid)
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if false;

      // Dados cadastrais privados: só o dono lê direto. Outras pessoas recebem esses dados
      // pela API, que confere se existe conversa individual ou grupo em comum.
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && docId == 'profile' && isValidPrivateProfile();
        allow delete: if false;
      }

      // Tokens de push: nunca ficam públicos. A API lê com o Admin SDK.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && isValidDevice();
      }
    }

    // ------------------------------------------------- conversas individuais
    // ID obrigatório: uidMenor_uidMaior (um único documento por par de usuários).
    function isValidNewDirectConversation(conversationId) {
      let d = incoming();
      let p = d.participantIds;
      return d.keys().hasOnly(['id', 'type', 'participantIds', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageAt'])
        && d.id == conversationId
        && d.type == 'direct'
        && p is list && p.size() == 2
        && p[0] is string && p[1] is string
        && p[0] < p[1] // ordenados e distintos: ninguém conversa consigo mesmo
        && conversationId == p[0] + '_' + p[1]
        && request.auth.uid in p
        && exists(/databases/$(database)/documents/users/$(p[0]))
        && exists(/databases/$(database)/documents/users/$(p[1]))
        && isValidTimestamp(d.createdAt);
    }

    match /directConversations/{conversationId} {
      // get em documento inexistente é liberado só para quem faz parte do ID (necessário no
      // "criar ou localizar"); caso contrário, somente participantes.
      allow get: if signedIn() && (
        (resource == null && conversationId.split('_').hasAny([request.auth.uid]))
        || (resource != null && request.auth.uid in resource.data.participantIds)
      );
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn() && isValidNewDirectConversation(conversationId);

      // Participantes só atualizam o resumo da última mensagem
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
        && (!('lastMessage' in incoming()) || (incoming().lastMessage is string && incoming().lastMessage.size() <= 200));

      allow delete: if false;
    }

    // ----------------------------------------------------------------- grupos
    function isValidGroup(d) {
      return d.keys().hasOnly([
          'id', 'name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit', 'notificationPolicy',
          'notificationPolicyUpdatedBy', 'notificationPolicyUpdatedAt',
          'createdAt', 'updatedAt', 'lastMessage', 'lastMessageAt'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && isValidPhotoUrl(d.photoUrl)
        && d.ownerId is string
        && d.memberIds is list
        && d.memberIds.toSet().size() == d.memberIds.size() // sem duplicados
        && d.ownerId in d.memberIds
        && d.memberLimit is int && d.memberLimit >= 2 && d.memberLimit <= 100
        // LIMITE DE INTEGRANTES: avaliado no servidor em TODA escrita, inclusive dentro de
        // transações concorrentes — nenhuma combinação de requisições ultrapassa o limite.
        && d.memberIds.size() <= d.memberLimit
        && d.notificationPolicy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
        && (!('lastMessage' in d) || (d.lastMessage is string && d.lastMessage.size() <= 200));
    }

    match /groups/{groupId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && isValidGroup(incoming())
        && incoming().id == groupId
        && incoming().ownerId == request.auth.uid
        && incoming().memberIds.size() >= 2
        && isValidTimestamp(incoming().createdAt);

      allow update: if signedIn() && isValidGroup(incoming()) && (
        // 1) Proprietário: gerencia nome, foto, integrantes, limite e política
        (resource.data.ownerId == request.auth.uid
          && !changedKeys().hasAny(['id', 'ownerId', 'createdAt']))
        ||
        // 2) Integrante comum: só pode remover a si mesmo (sair do grupo)
        (request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && changedKeys().hasOnly(['memberIds', 'updatedAt'])
          && incoming().memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet()))
        ||
        // 3) Integrante: atualiza o resumo da última mensagem
        (request.auth.uid in resource.data.memberIds
          && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt']))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Registro de idempotência dos pushes — acessível apenas pela API (Admin SDK)
    match /notifiedMessages/{messageKey} {
      allow read, write: if false;
    }
  }
}
