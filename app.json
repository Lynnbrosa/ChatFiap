{
  "expo": {
    "name": "FIAP Chat",
    "slug": "fiap-chat-firebase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiapchat.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fiapchat.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6366F1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O FIAP Chat acessa suas fotos para você escolher a foto de perfil e a foto dos grupos.",
          "cameraPermission": "O FIAP Chat usa a câmera para você tirar a foto de perfil e a foto dos grupos.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "notificationsApiUrl": "https://fiap-chat-notifications-api.onrender.com",
      "eas": {
        "projectId": "789ae33e-c143-4c4a-8195-1d73b75eca87"
      }
    },
    "owner": "rinkubr13"
  }
}
