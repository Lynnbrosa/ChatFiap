# Porta do servidor (a hospedagem normalmente define sozinha)
PORT=3000

# Credenciais do Firebase Admin SDK.
# ATENÇÃO: configure os valores reais SOMENTE nas variáveis secretas da hospedagem (ex.: Render).
# Nunca coloque a chave privada neste arquivo, no código ou no GitHub.
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Cloudinary (armazenamento das fotos de perfil e de grupo) — painel do Cloudinary → API Keys
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
CLOUDINARY_API_SECRET=CONFIGURAR_APENAS_NA_HOSPEDAGEM
